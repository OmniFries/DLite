{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DLite",
  "version": "0.2.0",
  "identifier": "app.dlite.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DLite",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OmniFries",
    "copyright": "\u00a9 2026 OmniFries",
    "category": "GraphicsAndDesign",
    "shortDescription": "A lightweight drawing app",
    "longDescription": "DLite is a lightweight drawing app with raster and vector layers, pressure brushes, Animate-style vector editing and a clean interface.",
    "fileAssociations": [
      {
        "ext": [
          "lite"
        ],
        "name": "DLite drawing",
        "description": "DLite drawing",
        "mimeType": "application/x-dlite",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QjUwQTQzMTg1MkU4OUIKUldTYjZGSVlRd3ExTlRjWStRYWQ2ZVJydWQxQlNVSGVwZkQ3bWQxTU5FK2NIUzN6TmdpWjRnWWIK",
      "endpoints": [
        "https://github.com/OmniFries/DLite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}